// Camera keys, captions and label windows. Numbers in captions come from physics.
import { makeCameraRig, type CameraKey } from "../../src/core/camera";
import type { Caption } from "../../src/core/Captions";
import { fmtInt } from "../../src/core/math";
import { resolveCaptions } from "../../src/core/spec";
import { spec } from "./meta";
import { bangsPerSecond, CYLINDERS, REDLINE, SLOW } from "./physics";

const KEYS: CameraKey[] = [
  { t: 0, pos: [10, 7, 12], target: [0, 3.5, 0], fov: 40 },
  { t: 3, pos: [9, 7, 13], target: [0, 3.5, 0], fov: 40 },
  { t: 14, pos: [0, 6, 13], target: [0, 3.5, 0], fov: 40, via: [8, 10, 12] },
  { t: 24, pos: [-6, 7, 12], target: [0, 3.5, 0], fov: 40 },
  { t: 30, pos: [-10, 7, 12], target: [0, 3.5, 0], fov: 40 },
];

export const cameraAt = makeCameraRig(KEYS);

export const CAPTIONS: Caption[] = resolveCaptions(spec, { redline: fmtInt(REDLINE), cylinders: CYLINDERS, slow: SLOW, bangs: fmtInt(bangsPerSecond(REDLINE)) });

export const HUD_IN = 3.05;
